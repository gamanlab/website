{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamanlab-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Worker reachable at https://api.gamanlab.id (Cloudflare creates the DNS record itself).
  "routes": [{ "pattern": "api.gamanlab.id", "custom_domain": true }],

  // Email Routing binding. No destination_address here so the recipient stays out of the
  // public repo; it is passed as the CONTACT_TO secret and must be a verified destination.
  "send_email": [{ "name": "CONTACT" }],

  // Sender address on the Email Routing domain (does not need to be a real mailbox).
  "vars": { "CONTACT_FROM": "noreply@gamanlab.id" },

  "observability": { "enabled": true }
}
